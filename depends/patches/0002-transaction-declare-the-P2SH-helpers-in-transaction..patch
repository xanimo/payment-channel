From 11fe777ff8e191e0b61296ec81c829d4afb05327 Mon Sep 17 00:00:00 2001
From: bluezr <bluezr@dogecoin.com>
Date: Fri, 28 Aug 2026 19:03:51 -0700
Subject: [PATCH 2/7] transaction: declare the P2SH helpers in transaction.h

test/transaction_tests.c includes transaction.h, not libdogecoin.h, so both
get_p2sh_multisig_address and the new get_p2sh_address_from_script were called
without a prototype. gcc warns; clang and the optee build reject it:

    call to undeclared function 'get_p2sh_multisig_address'; ISO C99 and later
    do not support implicit function declarations

x86_64-macos, arm64-macos and aarch64-linux-optee failed on that. 104/104.
---
 include/dogecoin/transaction.h | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/include/dogecoin/transaction.h b/include/dogecoin/transaction.h
index ff46f5cb..f8f6d254 100644
--- a/include/dogecoin/transaction.h
+++ b/include/dogecoin/transaction.h
@@ -187,6 +187,19 @@ LIBDOGECOIN_API int dogecoin_tx_sign_ts(dogecoin_tx* tx, struct dogecoin_wallet_
 /* THREAD-SAFE variant - uses internal mutex */
 LIBDOGECOIN_API int dogecoin_tx_finalize_ts(dogecoin_tx* tx);
 
+/* P2SH address helpers. Declared here as well as in libdogecoin.h so in-tree
+   callers that include this header rather than the public one get a prototype;
+   without it clang and the optee build reject the call outright while gcc only
+   warns. */
+LIBDOGECOIN_API int get_p2sh_multisig_address(const char** pubkeys_hex, int n, int m,
+                                              int is_testnet,
+                                              char* p2sh_addr_out, size_t p2sh_addr_cap,
+                                              char* redeem_script_hex_out,
+                                              size_t redeem_script_hex_cap);
+LIBDOGECOIN_API int get_p2sh_address_from_script(const char* redeem_script_hex,
+                                                 int is_testnet,
+                                                 char* p2sh_addr_out, size_t p2sh_addr_cap);
+
 LIBDOGECOIN_END_DECL
 
 #endif // __LIBDOGECOIN_TRANSACTION_H__
-- 
