# Hardened unit for the merchant daemon. Runs bob unprivileged, sandboxed, and
# with its key read from a file rather than the command line so it never appears
# in ps. Adjust the WIF path, the listen address, the height source, and the
# prices, then:
#
#   useradd --system --no-create-home --shell /usr/sbin/nologin bob
#   install -o bob -g bob -m 0600 /dev/stdin /etc/payment-channel/bob.wif <<< "$WIF"
#   install -o root -g root -m 0755 bob /usr/local/bin/bob
#   systemctl enable --now bob
#
# This does not put bob on a public port. Terminate TLS or a tunnel (wireguard,
# ssh, tor) in front of it and keep --listen on loopback: the wire protocol is
# plaintext and unauthenticated, so a public port exposes every channel to any
# observer and to an active man in the middle. See README "deployment".

[Unit]
Description=unidirectional payment channel merchant
After=network-online.target
Wants=network-online.target
# --confirm-cmd asks a kwd over its socket, so kwd has to be up first. That unit
# is koinu's and is not shipped here. Drop the --daemon for a --headers cache
# instead and this ordering goes with it, but read the budget note in the README
# first: a kw that syncs for itself does not answer inside bob's three seconds on
# mainnet, warm cache or not.
#
# kwd binds that socket 0600 and takes no group option, so it has to run as the
# same User= as this unit or every confirm gets a permission denied. It also
# needs a peer serving bip158 filters and exits at startup without one, which
# most mainnet nodes are not.
After=kwd.service
Wants=kwd.service

[Service]
Type=simple
User=bob
Group=bob
# All three of --state, --height-file and --confirm-cmd are refusals at startup
# rather than defaults, so a unit missing any of them restart-loops printing the
# reason. --height is not enough: a fixed number is correct once, and this runs
# for as long as it runs. Something that can see a chain writes height.txt.
ExecStart=/usr/local/bin/bob --wif @/etc/payment-channel/bob.wif \
    --listen 127.0.0.1:9876 --min-slack 100 \
    --height-file /var/lib/payment-channel/height.txt \
    --state /var/lib/payment-channel/channels \
    --confirm-cmd "/usr/local/bin/kw outpoint --daemon /run/kwd.sock" \
    --broadcast-cmd "/usr/local/bin/kw send --node NODE --yes" \
    --min-depth 6 \
    --price 5.0 --price 7.5 --price 17.5
Restart=on-failure
RestartSec=2

# ProtectSystem=strict makes everything read-only, so the state directory has to
# be named or every payment fails to record. The ratchet is the one thing bob
# writes; the key and the height feed he only reads. The header cache belongs to
# kwd now, so it is not named here; put it back if --confirm-cmd goes back to a
# kw that fills one itself.
ReadWritePaths=/var/lib/payment-channel/channels
ReadOnlyPaths=/etc/payment-channel/bob.wif /var/lib/payment-channel/height.txt

# Sandbox: no privileges, no new ones, minimal view of the system.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
# A child per connection over an inet stream socket, and each of those forks a
# confirm backend. AF_UNIX because a backend reaching a local node over a socket,
# or anything going through nscd, gets EAFNOSUPPORT rather than an error it can
# report. This said AF_INET alone from when a backend was optional.
RestrictAddressFamilies=AF_INET AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native

# cgroup bounds on the whole service, alongside the per-connection rlimits bob
# sets on each child. The arithmetic is MAX_CONNS of 64 children, plus the
# parent, plus a confirm backend per child, and pc_run_backend puts each backend
# in its own process group so a wrapper script with a child of its own counts
# too. 128 was written for a bob that forked nothing and is one short of the
# floor before the backends are counted at all.
TasksMax=512

# Not the same bound as CHILD_AS_BYTES in bob.c, which happens to carry the same
# number: that is 512MB of address space per child, this is resident memory
# across the parent, all 64 children and every backend they fork. The figure
# suits the --daemon shape above, where a backend is a socket request and holds
# no chain. Point --confirm-cmd at a kw that loads a header store instead and
# this is the wrong bound as well as the wrong rlimit; see the README on why
# that form does not belong under a serving bob.
MemoryMax=512M
CPUQuota=200%

[Install]
WantedBy=multi-user.target
